{
  "name": "mandela-generals",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc --noEmit && vite build --mode production",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "preview": "vite preview --mode production",
    "preview:dev": "vite preview --mode development",
    "deploy:dev": "npm run build:dev && firebase deploy --only hosting --project development"
  },
  "dependencies": {
    "firebase": "^9.14.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
