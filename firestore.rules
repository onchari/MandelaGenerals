rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformAdminPath(uid) {
      return /databases/$(database)/documents/platformAdmins/$(uid);
    }

    function isPlatformAdmin() {
      return signedIn()
        && exists(platformAdminPath(request.auth.uid))
        && get(platformAdminPath(request.auth.uid)).data.enabled == true
        && get(platformAdminPath(request.auth.uid)).data.role == 'platformAdmin';
    }

    function memberPath(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid);
    }

    function membershipIndexPath(uid, businessId) {
      return /databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId);
    }

    function branchPath(businessId, branchId) {
      return /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId);
    }

    function businessPath(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId);
    }

    function allowsLegacyProducts(businessId) {
      return exists(businessPath(businessId))
        && get(businessPath(businessId)).data.get('branchWorkspaceMode', '') != 'isolated';
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveUserProfile(uid) {
      return exists(userPath(uid))
        && get(userPath(uid)).data.get('accountStatus', 'active') == 'active';
    }

    function isMember(businessId) {
      return signedIn()
        && exists(memberPath(businessId))
        && get(memberPath(businessId)).data.active == true;
    }

    function isDemoTenant(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.slug == 'demo';
    }

    function hasRole(businessId, roles) {
      return isMember(businessId)
        && get(memberPath(businessId)).data.role in roles;
    }

    function isOwner(businessId) {
      return hasRole(businessId, ['owner']);
    }

    function isAssignedToBranch(businessId, branchId) {
      return isMember(businessId)
        && (
          get(memberPath(businessId)).data.get('allBranches', false) == true
          || (
            get(memberPath(businessId)).data.get('branchIds', []) is list
            && get(memberPath(businessId)).data.get('branchIds', []).hasAny([branchId])
          )
        )
        && exists(branchPath(businessId, branchId))
        && get(branchPath(businessId, branchId)).data.status == 'active';
    }

    function canAccessBranch(businessId, branchId) {
      return isOwner(businessId) || isAssignedToBranch(businessId, branchId);
    }

    function canUseBranch(businessId, branchId) {
      return exists(branchPath(businessId, branchId))
        && get(branchPath(businessId, branchId)).data.status == 'active'
        && canAccessBranch(businessId, branchId);
    }

    function canReadBranchRecord(businessId, data) {
      return !('branchId' in data)
        || (data.branchId is string && canAccessBranch(businessId, data.branchId));
    }

    function validBranchScope(businessId, data) {
      return ('branchId' in data)
        ? (data.branchId is string && canUseBranch(businessId, data.branchId))
        : !get(businessPath(businessId)).data.keys().hasAny(['primaryBranchId']);
    }

    function isManager(businessId) {
      return hasRole(businessId, ['owner', 'admin', 'manager']);
    }

    function isAdmin(businessId) {
      return hasRole(businessId, ['owner', 'admin']);
    }

    function canSell(businessId) {
      return hasRole(businessId, ['owner', 'admin', 'manager', 'cashier']);
    }

    function dayPath(businessId, dayId) {
      return /databases/$(database)/documents/businesses/$(businessId)/business_days/$(dayId);
    }

    function dayUnlocked(businessId, dayId) {
      return dayId is string
        && exists(dayPath(businessId, dayId))
        && get(dayPath(businessId, dayId)).data.status != 'LOCKED';
    }

    function dayNotLocked(businessId, dayId) {
      return dayId is string
        && (!exists(dayPath(businessId, dayId))
          || get(dayPath(businessId, dayId)).data.status != 'LOCKED');
    }

    function syncKeys() {
      return ['updatedAt', '_syncVersion', '_syncClient', '_syncUpdatedAt', '_syncMutationId'];
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function sellDecrementOnly() {
      return onlyChanges(['qty'].concat(syncKeys()))
        && request.resource.data.qty is int
        && request.resource.data.qty < resource.data.qty;
    }

    function validStock() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.get('qty', 0) is int
        && request.resource.data.get('buyPrice', 0) >= 0
        && request.resource.data.get('sellPrice', 0) >= 0;
    }

    function validSale() {
      let sale = request.resource.data;
      return sale.qty is int && sale.qty > 0
        && sale.priceUsed is number && sale.priceUsed >= 0
        && sale.get('buyPrice', 0) >= 0
        && sale.businessDate is string;
    }

    function validFinance() {
      let finance = request.resource.data;
      return finance.type in ['investment', 'expense', 'withdrawal']
        && finance.amount is number && finance.amount > 0
        && finance.businessDate is string;
    }

    function validProduct() {
      let product = request.resource.data;
      return product.keys().hasAll([
          'name', 'sku', 'quantity', 'reorderLevel', 'costPrice', 'sellingPrice', 'createdAt'
        ])
        && product.keys().hasOnly([
          'name', 'sku', 'quantity', 'reorderLevel', 'costPrice', 'sellingPrice', 'createdAt'
        ])
        && product.name is string
        && product.name.size() > 0
        && product.name.size() <= 120
        && product.sku is string
        && product.sku.size() <= 120
        && product.quantity is int
        && product.quantity >= 0
        && product.quantity <= 9007199254740991
        && product.reorderLevel is int
        && product.reorderLevel >= 0
        && product.reorderLevel <= 9007199254740991
        && product.costPrice is int
        && product.costPrice >= 0
        && product.costPrice <= 9007199254740991
        && product.sellingPrice is int
        && product.sellingPrice >= 0
        && product.sellingPrice <= 9007199254740991;
    }

    function validBranch() {
      let branch = request.resource.data;
      return branch.keys().hasAll(['name', 'status', 'createdAt', 'isPrimary'])
        && branch.keys().hasOnly(['name', 'address', 'status', 'createdAt', 'isPrimary', 'managerUid'])
        && branch.name is string
        && branch.name.size() > 0
        && branch.name.size() <= 100
        && (!('address' in branch)
          || (branch.address is string && branch.address.size() <= 300))
        && (!('managerUid' in branch) || branch.managerUid is string)
        && branch.status in ['active', 'inactive']
        && branch.createdAt is timestamp
        && branch.isPrimary is bool;
    }

    function validBranchWorkspace(businessId, branchId) {
      let workspace = request.resource.data;
      return workspace.keys().hasAll(['parentBusinessId', 'branchId', 'inventoryMode', 'createdAt'])
        && workspace.keys().hasOnly(['parentBusinessId', 'branchId', 'inventoryMode', 'createdAt'])
        && workspace.parentBusinessId == businessId
        && workspace.branchId == branchId
        && workspace.inventoryMode == 'branch_scoped'
        && workspace.createdAt is timestamp;
    }

    function validBranchAssignments(data) {
      return (!('branchIds' in data) || data.branchIds is list)
        && (!('allBranches' in data) || data.allBranches is bool);
    }

    function validNewMemberBranchAssignments(data) {
      return data.branchIds is list
        && data.branchIds.size() == 0
        && data.allBranches == false;
    }

    function validBusinessRole(role) {
      return role in ['admin', 'manager', 'cashier', 'staff'];
    }

    function validBranchMemberBootstrap(businessId, data) {
      return validBranchAssignments(data)
        && (!('branchIds' in data)
          || (data.branchIds.size() == 1 && data.branchIds.hasAny(['main'])
            && existsAfter(branchPath(businessId, 'main'))));
    }

    function validDemoBranchAssignments(businessId, data) {
      return validBranchAssignments(data)
        && (!('branchIds' in data)
          || (data.branchIds.size() == 1 && data.branchIds.hasAny(['main'])
            && existsAfter(branchPath(businessId, 'main'))))
        && (!('allBranches' in data) || data.allBranches == false);
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'phoneNumber',
          'accountStatus', 'invitationStatus', 'emailVerificationStatus',
          'invitedAt', 'invitedBy', 'invitationExpiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'createdAt',
          'accountStatus', 'invitationStatus', 'emailVerificationStatus',
          'invitedAt', 'invitedBy', 'invitationExpiresAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.invitationStatus == 'not_invited'
        && request.resource.data.emailVerificationStatus == 'not_required'
        && request.resource.data.invitedAt == null
        && request.resource.data.invitedBy == null
        && request.resource.data.invitationExpiresAt == null
        && (!('phoneNumber' in request.resource.data)
          || (request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber.size() <= 32));
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phoneNumber'])
        && request.resource.data.displayName is string
        && (!('phoneNumber' in request.resource.data)
          || (request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber.size() <= 32));
      allow delete: if false;

      match /businessMemberships/{businessId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
        allow create: if (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.keys().hasAll(['businessName', 'role', 'active', 'joinedAt'])
            && request.resource.data.keys().hasOnly(['businessName', 'slug', 'role', 'active', 'joinedAt', 'branchIds', 'allBranches', 'branchWorkspaceMode'])
            && request.resource.data.businessName is string
            && request.resource.data.businessName.size() > 0
            && request.resource.data.businessName.size() <= 100
            && request.resource.data.slug is string
            && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
            && request.resource.data.slug.size() <= 48
            && request.resource.data.role == 'owner'
            && request.resource.data.active == true
            && request.resource.data.joinedAt is timestamp
            && (!('branchWorkspaceMode' in request.resource.data)
              || (request.resource.data.branchWorkspaceMode == 'isolated'
                && getAfter(businessPath(businessId)).data.branchWorkspaceMode == 'isolated'))
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.slug == request.resource.data.slug
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.role == 'owner'
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.active == true
            && validBranchMemberBootstrap(businessId, request.resource.data)
            && (!('branchIds' in request.resource.data)
              || getAfter(memberPath(businessId)).data.branchIds == request.resource.data.branchIds)
            && (!('allBranches' in request.resource.data)
              || getAfter(memberPath(businessId)).data.allBranches == request.resource.data.allBranches)
          )
          || (
            isPlatformAdmin()
            && isDemoTenant(businessId)
            && request.resource.data.keys().hasAll(['businessName', 'slug', 'role', 'active', 'joinedAt'])
            && request.resource.data.keys().hasOnly(['businessName', 'slug', 'role', 'active', 'joinedAt', 'branchIds', 'allBranches', 'branchWorkspaceMode'])
            && request.resource.data.businessName == 'Demo'
            && request.resource.data.slug == 'demo'
            && request.resource.data.role == 'staff'
            && request.resource.data.active == true
            && request.resource.data.joinedAt is timestamp
            && (!('branchWorkspaceMode' in request.resource.data)
              || (request.resource.data.branchWorkspaceMode == 'isolated'
                && get(businessPath(businessId)).data.branchWorkspaceMode == 'isolated'))
            && validDemoBranchAssignments(businessId, request.resource.data)
            && (!('branchIds' in request.resource.data)
              || getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.branchIds == request.resource.data.branchIds)
            && (!('allBranches' in request.resource.data)
              || getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.allBranches == request.resource.data.allBranches)
          )
          || (
            isOwner(businessId)
            && uid != request.auth.uid
            && hasActiveUserProfile(uid)
            && exists(/databases/$(database)/documents/businessUserDirectory/$(uid))
            && get(/databases/$(database)/documents/businessUserDirectory/$(uid)).data.discoverable == true
            && request.resource.data.keys().hasAll(['businessName', 'role', 'active', 'joinedAt', 'branchIds', 'allBranches'])
            && request.resource.data.keys().hasOnly(['businessName', 'slug', 'role', 'active', 'joinedAt', 'branchIds', 'allBranches', 'branchWorkspaceMode'])
            && request.resource.data.businessName == get(businessPath(businessId)).data.name
            && (!('slug' in request.resource.data)
              || request.resource.data.slug == get(businessPath(businessId)).data.get('slug', ''))
            && validBusinessRole(request.resource.data.role)
            && request.resource.data.active == true
            && request.resource.data.joinedAt is timestamp
            && (!('branchWorkspaceMode' in request.resource.data)
              || (request.resource.data.branchWorkspaceMode == 'isolated'
                && get(businessPath(businessId)).data.branchWorkspaceMode == 'isolated'))
            && validNewMemberBranchAssignments(request.resource.data)
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.role == request.resource.data.role
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.active == true
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.branchIds == request.resource.data.branchIds
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.allBranches == request.resource.data.allBranches
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid)).data.joinedAt == request.resource.data.joinedAt
          );
        allow update: if (
            signedIn()
            && request.auth.uid == uid
            && isOwner(businessId)
            && resource.data.role == 'owner'
            && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slug'])
            && request.resource.data.slug is string
            && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
            && request.resource.data.slug.size() <= 48
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.slug == request.resource.data.slug
          )
          || (
            isOwner(businessId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branchIds', 'allBranches'])
            && validBranchAssignments(request.resource.data)
            && getAfter(memberPath(businessId)).data.branchIds == request.resource.data.branchIds
            && getAfter(memberPath(businessId)).data.allBranches == request.resource.data.allBranches
          )
          || (
            isOwner(businessId)
            && resource.data.role != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && validBusinessRole(request.resource.data.role)
            && getAfter(memberPath(businessId)).data.role == request.resource.data.role
          );
        allow delete: if false;
      }
    }

    match /platformAdmins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /businessUserDirectory/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || resource.data.discoverable == true);
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 100
        && resource.data.discoverable == true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email', 'displayName', 'discoverable', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'discoverable', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email == get(userPath(uid)).data.email
        && request.resource.data.displayName is string
        && request.resource.data.discoverable is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /environmentConfig/{configId} {
      allow read, write: if false;
    }

    match /devTesters/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /businessSlugs/{slug} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['businessId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['businessId', 'createdAt'])
        && request.resource.data.businessId is string
        && request.resource.data.createdAt is timestamp
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && slug.size() <= 48
        && getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.slug == slug;
      allow update, delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if isMember(businessId) || isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'name', 'slug', 'ownerId', 'createdAt', 'primaryBranchId', 'branchWorkspaceMode'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'slug', 'ownerId', 'createdAt', 'primaryBranchId', 'branchWorkspaceMode'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.slug.size() <= 48
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.branchWorkspaceMode == 'isolated'
        && request.resource.data.primaryBranchId == 'main'
        && getAfter(branchPath(businessId, request.resource.data.primaryBranchId)).data.isPrimary == true
        && getAfter(branchPath(businessId, request.resource.data.primaryBranchId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/businessSlugs/$(request.resource.data.slug)).data.businessId == businessId
        && getAfter(memberPath(businessId)).data.role == 'owner'
        && getAfter(memberPath(businessId)).data.active == true
        && getAfter(membershipIndexPath(request.auth.uid, businessId)).data.role == 'owner'
        && getAfter(membershipIndexPath(request.auth.uid, businessId)).data.active == true;
      allow update: if isOwner(businessId)
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slug'])
            && (!resource.data.keys().hasAny(['slug']) || resource.data.slug == '')
            && request.resource.data.slug is string
            && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
            && request.resource.data.slug.size() <= 48
            && getAfter(/databases/$(database)/documents/businessSlugs/$(request.resource.data.slug)).data.businessId == businessId
            && getAfter(membershipIndexPath(request.auth.uid, businessId)).data.slug == request.resource.data.slug
          )
          || (
            !resource.data.keys().hasAny(['primaryBranchId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primaryBranchId'])
            && request.resource.data.primaryBranchId == 'main'
            && getAfter(branchPath(businessId, 'main')).data.isPrimary == true
            && getAfter(branchPath(businessId, 'main')).data.status == 'active'
            && getAfter(memberPath(businessId)).data.branchIds == ['main']
            && getAfter(memberPath(businessId)).data.allBranches == true
            && getAfter(membershipIndexPath(request.auth.uid, businessId)).data.branchIds == ['main']
            && getAfter(membershipIndexPath(request.auth.uid, businessId)).data.allBranches == true
          )
        );
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(businessId);
        allow create: if (
            signedIn()
            && uid == request.auth.uid
            && request.resource.data.keys().hasAll(['role', 'active', 'joinedAt'])
            && request.resource.data.keys().hasOnly(['role', 'active', 'joinedAt', 'branchIds', 'allBranches'])
            && request.resource.data.role == 'owner'
            && request.resource.data.active == true
            && request.resource.data.joinedAt is timestamp
            && validBranchMemberBootstrap(businessId, request.resource.data)
            && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
            && getAfter(membershipIndexPath(request.auth.uid, businessId)).data.role == 'owner'
            && getAfter(membershipIndexPath(request.auth.uid, businessId)).data.active == true
            && (!('branchIds' in request.resource.data)
              || getAfter(membershipIndexPath(request.auth.uid, businessId)).data.branchIds == request.resource.data.branchIds)
            && (!('allBranches' in request.resource.data)
              || getAfter(membershipIndexPath(request.auth.uid, businessId)).data.allBranches == request.resource.data.allBranches)
          )
          || (
            isPlatformAdmin()
            && isDemoTenant(businessId)
            && request.resource.data.keys().hasAll(['role', 'active', 'joinedAt'])
            && request.resource.data.keys().hasOnly(['role', 'active', 'joinedAt', 'branchIds', 'allBranches'])
            && request.resource.data.role == 'staff'
            && request.resource.data.active == true
            && request.resource.data.joinedAt is timestamp
            && validDemoBranchAssignments(businessId, request.resource.data)
            && (!('branchIds' in request.resource.data)
              || getAfter(/databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId)).data.branchIds == request.resource.data.branchIds)
            && (!('allBranches' in request.resource.data)
              || getAfter(/databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId)).data.allBranches == request.resource.data.allBranches)
          )
          || (
            isOwner(businessId)
            && uid != request.auth.uid
            && hasActiveUserProfile(uid)
            && exists(/databases/$(database)/documents/businessUserDirectory/$(uid))
            && get(/databases/$(database)/documents/businessUserDirectory/$(uid)).data.discoverable == true
            && request.resource.data.keys().hasAll(['role', 'active', 'joinedAt', 'branchIds', 'allBranches'])
            && request.resource.data.keys().hasOnly(['role', 'active', 'joinedAt', 'branchIds', 'allBranches'])
            && validBusinessRole(request.resource.data.role)
            && request.resource.data.active == true
            && request.resource.data.joinedAt is timestamp
            && validNewMemberBranchAssignments(request.resource.data)
            && getAfter(/databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId)).data.role == request.resource.data.role
            && getAfter(/databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId)).data.active == true
            && getAfter(/databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId)).data.branchIds == request.resource.data.branchIds
            && getAfter(/databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId)).data.allBranches == request.resource.data.allBranches
            && getAfter(/databases/$(database)/documents/users/$(uid)/businessMemberships/$(businessId)).data.joinedAt == request.resource.data.joinedAt
          );
        allow update: if isOwner(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branchIds', 'allBranches'])
          && validBranchAssignments(request.resource.data)
          && getAfter(membershipIndexPath(uid, businessId)).data.branchIds == request.resource.data.branchIds
          && getAfter(membershipIndexPath(uid, businessId)).data.allBranches == request.resource.data.allBranches
          || (
            isOwner(businessId)
            && resource.data.role != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && validBusinessRole(request.resource.data.role)
            && getAfter(membershipIndexPath(uid, businessId)).data.role == request.resource.data.role
          );
        allow delete: if false;
      }

      match /branches/{branchId} {
        allow read: if canAccessBranch(businessId, branchId);
        allow create: if getAfter(businessPath(businessId)).data.keys().hasAny(['primaryBranchId'])
          && validBranch()
          && (!('managerUid' in request.resource.data) || request.resource.data.managerUid == '')
          && request.resource.data.isPrimary ==
            (getAfter(businessPath(businessId)).data.get('primaryBranchId', '') == branchId)
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/settings/workspace).data.parentBusinessId == businessId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/settings/workspace).data.branchId == branchId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/settings/workspace).data.inventoryMode == 'branch_scoped'
          && (
            isOwner(businessId)
            || (
              signedIn()
              && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
              && getAfter(memberPath(businessId)).data.role == 'owner'
              && getAfter(memberPath(businessId)).data.active == true
            )
          );
        allow update: if isOwner(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'status', 'managerUid'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && (!('address' in request.resource.data)
            || (request.resource.data.address is string
              && request.resource.data.address.size() <= 300))
          && request.resource.data.status in ['active', 'inactive']
          && (
            !('managerUid' in request.resource.data)
            || (
              request.resource.data.managerUid is string
              && (
                request.resource.data.managerUid == ''
                || request.resource.data.managerUid == request.auth.uid
              )
            )
          )
          && (
            request.resource.data.status != 'inactive'
            || get(businessPath(businessId)).data.get('primaryBranchId', '') != branchId
          );
        allow delete: if false;

        match /settings/{settingId} {
          allow read: if settingId == 'workspace' && canAccessBranch(businessId, branchId);
          allow create: if settingId == 'workspace'
            && validBranchWorkspace(businessId, branchId)
            && getAfter(branchPath(businessId, branchId)).data.status == 'active'
            && (
              isOwner(businessId)
              || (
                signedIn()
                && getAfter(businessPath(businessId)).data.ownerId == request.auth.uid
                && getAfter(memberPath(businessId)).data.role == 'owner'
                && getAfter(memberPath(businessId)).data.active == true
              )
            );
          allow update, delete: if false;
        }

        match /products/{productId} {
          allow read: if canAccessBranch(businessId, branchId);
          allow create: if canUseBranch(businessId, branchId)
            && isManager(businessId)
            && validProduct();
          allow update: if canUseBranch(businessId, branchId)
            && isManager(businessId)
            && validProduct()
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if canUseBranch(businessId, branchId) && isManager(businessId);
        }
      }

      match /products/{productId} {
        allow read: if allowsLegacyProducts(businessId) && isMember(businessId);
        allow create: if allowsLegacyProducts(businessId) && isManager(businessId) && validProduct();
        allow update: if allowsLegacyProducts(businessId)
          && isManager(businessId)
          && validProduct()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if allowsLegacyProducts(businessId) && isManager(businessId);
      }

      match /invites/{inviteId} {
        allow read: if isAdmin(businessId);
        allow write: if false;
      }

      match /items/{itemId} {
        allow read: if isMember(businessId);
        allow create: if isManager(businessId) && validStock();
        allow update: if (isManager(businessId) && validStock())
          || (canSell(businessId) && sellDecrementOnly());
        allow delete: if false;
      }

      match /shoe_sizes/{itemId} {
        allow read: if isMember(businessId);
        allow create: if isManager(businessId) && validStock();
        allow update: if (isManager(businessId) && validStock())
          || (canSell(businessId) && sellDecrementOnly());
        allow delete: if false;
      }

      match /stock_moves/{moveId} {
        allow read: if isMember(businessId)
          && canReadBranchRecord(businessId, resource.data);
        allow create: if canSell(businessId)
          && request.resource.data.delta is int
          && request.resource.data.itemId is string
          && validBranchScope(businessId, request.resource.data);
        allow update, delete: if false;
      }

      match /sales/{saleId} {
        allow read: if canSell(businessId)
          && canReadBranchRecord(businessId, resource.data);
        allow create: if canSell(businessId)
          && validSale()
          && validBranchScope(businessId, request.resource.data)
          && dayUnlocked(businessId, request.resource.data.businessDate);
        allow update: if isManager(businessId)
          && validSale()
          && validBranchScope(businessId, request.resource.data)
          && request.resource.data.get('branchId', null) == resource.data.get('branchId', null)
          && dayUnlocked(businessId, resource.data.businessDate)
          && dayUnlocked(businessId, request.resource.data.businessDate);
        allow delete: if false;
      }

      match /finances/{entryId} {
        allow read: if isManager(businessId);
        allow create: if isManager(businessId)
          && validFinance()
          && dayNotLocked(businessId, request.resource.data.businessDate);
        allow update: if isManager(businessId)
          && onlyChanges(['voided', 'voidedBy', 'voidedAt'].concat(syncKeys()))
          && dayNotLocked(businessId, resource.data.businessDate);
        allow delete: if false;
      }

      match /business_days/{dayId} {
        allow read: if isMember(businessId);
        allow create: if canSell(businessId)
          && request.resource.data.businessDate == dayId
          && request.resource.data.status == 'OPEN';
        allow update: if isManager(businessId)
          && resource.data.status != 'LOCKED'
          && request.resource.data.businessDate == resource.data.businessDate
          && request.resource.data.status in ['OPEN', 'CLOSED', 'LOCKED']
          && (request.resource.data.status != 'LOCKED' || isAdmin(businessId));
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, create, update: if isManager(businessId);
        allow delete: if hasRole(businessId, ['owner', 'admin']);
      }

      match /cashTransactions/{transactionId} {
        allow read, create: if isManager(businessId);
        allow update, delete: if false;
      }

      match /employees/{employeeId} {
        allow read, create, update: if isManager(businessId);
        allow delete: if isOwner(businessId);
      }

      match /payroll/{payrollId} {
        allow read, create, update: if hasRole(businessId, ['owner', 'admin']);
        allow delete: if false;
      }

      match /types/{typeId} {
        allow read: if isMember(businessId);
        allow create, update: if isManager(businessId);
        allow delete: if false;
      }

      match /wishlist/{itemId} {
        allow read, create, update, delete: if isManager(businessId);
      }

      match /purchase_budgets/{budgetId} {
        allow read, create, update, delete: if isManager(businessId);
      }

      match /customers/{customerId} {
        allow read, create, update: if canSell(businessId);
        allow delete: if false;
      }

      match /customer_txns/{transactionId} {
        allow read, create: if canSell(businessId);
        allow update: if isManager(businessId);
        allow delete: if false;
      }

      match /sync_metadata/{docId} {
        allow read, write: if isMember(businessId)
          && docId.matches(request.auth.uid + '_.*');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
